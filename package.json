{
  "name": "admin-dashboard-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "setup": "./infrastructure/scripts/setup-terraform.sh",
    "infra:plan": "./infrastructure/scripts/setup-terraform.sh plan",
    "infra:apply": "./infrastructure/scripts/setup-terraform.sh apply",
    "infra:destroy": "./infrastructure/scripts/setup-terraform.sh destroy",
    "dev": "concurrently -n fe,be -c green,blue \"bun run dev:frontend\" \"bun run dev:backend\"",
    "dev:full": "./scripts/dev.sh",
    "dev:frontend": "cd packages/frontend && bun run dev",
    "dev:backend": "cd packages/backend && bun run dev",
    "dev:ai-service": "./scripts/dev-ai-service.sh",
    "build": "bun run build:backend && bun run build:frontend",
    "build:frontend": "cd packages/frontend && bun run build",
    "build:backend": "cd packages/backend && bun run build",
    "build:ai-service": "cd packages/ai-service && bun run build",
    "test": "bun run --filter '*' test",
    "test:unit": "bun run --filter '*' test:unit",
    "test:coverage": "bun run --filter '*' test:coverage",
    "test:e2e": "bun run --filter frontend test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist",
    "deploy": "firebase deploy",
    "deploy:staging": "firebase deploy --project staging",
    "deploy:prod": "firebase deploy --project production",
    "emulators": "firebase emulators:start"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.1.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.1.0"
}
