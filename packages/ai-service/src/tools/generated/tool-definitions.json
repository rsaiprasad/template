    "name": "getFeatures",
    "description": "Get feature flags. Retrieves the current state of all feature flags.",
    "parameters": {
      "type": "object",
      "properties": {}
    },
    "metadata": {
      "method": "GET",
      "path": "/settings/features",
      "requiredPermission": "settings:read"
    }
  },
  {
