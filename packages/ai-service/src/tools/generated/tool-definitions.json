    "parameters": {
      "type": "object",
      "properties": {
        "appName": {
          "type": "string",
          "description": "Application name"
        },
        "defaultGroupId": {
          "type": "string",
          "description": "Default group ID for new users"
        },
        "features": {
          "type": "object",
          "description": "Feature flags",
          "properties": {
            "auditLogging": {
              "type": "boolean"
            },
            "userRegistration": {
