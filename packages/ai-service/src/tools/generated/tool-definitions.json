  {
    "name": "listAuditLogs",
    "description": "List audit logs. Retrieves a paginated list of audit logs with optional filtering by action, resource, actor, and date range.",
    "parameters": {
      "type": "object",
      "properties": {
        "page": {
          "type": "string",
          "description": "Page number (1-indexed)"
        },
        "limit": {
          "type": "string",
          "description": "Number of items per page (max 100)"
        },
        "action": {
          "type": "string",
          "description": "Filter by action type"
        },
        "resource": {
          "type": "string",
          "description": "Filter by resource type"
        },
        "actorId": {
          "type": "string",
          "description": "Filter by actor ID"
        },
        "startDate": {
          "type": "string",
          "description": "Filter by start date (ISO 8601)"
        },
        "endDate": {
          "type": "string",
          "description": "Filter by end date (ISO 8601)"
        },
        "sortOrder": {
          "type": "string",
          "description": "Sort order",
