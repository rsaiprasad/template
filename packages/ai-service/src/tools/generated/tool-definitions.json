      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "description": "Resource type"
        },
        "resourceId": {
          "type": "string",
          "description": "Resource ID"
        },
        "limit": {
          "type": "string",
          "description": "Maximum number of logs to return"
        }
      },
      "required": ["resource", "resourceId"]
    },
    "metadata": {
      "method": "GET",
      "path": "/audit/resource/{resource}/{resourceId}",
      "requiredPermission": "audit:read"
    }
  },
  {
