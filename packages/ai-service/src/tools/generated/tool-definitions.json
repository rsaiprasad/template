  {
    "name": "getAuditLogsForUser",
    "description": "Get audit logs for a user. Retrieves audit logs where the specified user was the actor (performer of the action).",
    "parameters": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User unique identifier"
        },
        "limit": {
          "type": "string",
          "description": "Maximum number of logs to return"
