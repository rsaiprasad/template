  },
  {
    "name": "updateGroupPermissions",
    "description": "Update group permissions. Replaces all permissions for a group with the specified list of permissions.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
