[
  {
    "name": "getCurrentUser",
    "description": "Get current user. Returns the current authenticated user's information including their permissions.",
    "parameters": {
      "type": "object",
      "properties": {}
    },
    "metadata": {
      "method": "GET",
      "path": "/auth/me",
      "requiredPermission": null
    }
  },
  {
    "name": "listUsers",
    "description": "List all users. Retrieves a paginated list of users with optional filtering by status, group, and search query. Supports cursor-based pagination.",
    "parameters": {
      "type": "object",
      "properties": {
        "page": {
          "type": "string",
          "description": "Page number (1-indexed)"
        },
        "limit": {
          "type": "string",
          "description": "Number of items per page (max 100)"
        },
        "status": {
          "type": "string",
          "description": "Filter by user status",
          "enum": ["active", "disabled", "all"]
        },
        "groupId": {
          "type": "string",
          "description": "Filter by group ID"
        },
        "query": {
          "type": "string",
          "description": "Search query for email or name"
        },
        "sortBy": {
          "type": "string",
          "description": "Field to sort by"
        },
        "sortOrder": {
          "type": "string",
          "description": "Sort order",
          "enum": ["asc", "desc"]
        },
        "cursor": {
          "type": "string",
          "description": "Cursor for pagination"
        }
      }
    },
    "metadata": {
      "method": "GET",
      "path": "/users",
      "requiredPermission": "users:read"
    }
  },
  {
    "name": "getUser",
    "description": "Get user by ID. Retrieves detailed information about a specific user including their permissions.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        }
      },
      "required": ["id"]
    },
    "metadata": {
      "method": "GET",
      "path": "/users/{id}",
      "requiredPermission": "users:read"
    }
  },
  {
    "name": "updateUser",
    "description": "Update user. Updates a user's display name, photo URL, or preferences. Cannot modify super administrator accounts unless you are also a super admin.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User profile photo URL"
        },
        "preferences": {
          "type": "object",
          "description": "User preferences",
          "properties": {
            "theme": {
              "type": "string",
              "enum": ["light", "dark", "system"]
            }
          }
        }
      },
      "required": ["id"]
    },
    "metadata": {
      "method": "PUT",
      "path": "/users/{id}",
      "requiredPermission": "users:write"
    }
  },
  {
    "name": "deleteUser",
    "description": "Delete user. Permanently deletes a user. Cannot delete yourself or super administrator accounts.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        }
      },
      "required": ["id"]
    },
    "metadata": {
      "method": "DELETE",
      "path": "/users/{id}",
      "requiredPermission": "users:write"
    }
  },
  {
    "name": "disableUser",
    "description": "Disable user. Disables a user account, preventing them from logging in. Cannot disable yourself.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        }
      },
      "required": ["id"]
    },
    "metadata": {
      "method": "POST",
      "path": "/users/{id}/disable",
      "requiredPermission": "users:write"
    }
  },
  {
    "name": "enableUser",
    "description": "Enable user. Re-enables a previously disabled user account.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        }
      },
      "required": ["id"]
    },
    "metadata": {
      "method": "POST",
      "path": "/users/{id}/enable",
      "requiredPermission": "users:write"
    }
  },
  {
    "name": "changeUserGroup",
    "description": "Change user group. Changes the group a user belongs to, affecting their permissions. Cannot modify super administrator accounts unless you are also a super admin.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "groupId": {
          "type": "string",
          "description": "ID of the new group"
        }
      },
      "required": ["id", "groupId"]
    },
    "metadata": {
      "method": "PUT",
      "path": "/users/{id}/group",
      "requiredPermission": "users:write"
    }
  },
  {
    "name": "listGroups",
    "description": "List all groups. Retrieves a list of all groups. Optionally includes user counts for each group.",
    "parameters": {
      "type": "object",
      "properties": {
        "includeUserCounts": {
          "type": "string",
          "description": "Include user count for each group",
          "enum": ["true", "false"]
        }
      }
    },
    "metadata": {
      "method": "GET",
      "path": "/groups",
      "requiredPermission": "groups:read"
    }
  },
  {
    "name": "createGroup",
    "description": "Create a new group. Creates a new group with the specified name, description, and optional initial permissions.",
    "parameters": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Group name"
        },
        "description": {
          "type": "string",
          "description": "Group description"
        },
        "permissions": {
          "type": "array",
          "description": "List of permissions to assign",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["name"]
    },
    "metadata": {
      "method": "POST",
      "path": "/groups",
      "requiredPermission": "groups:write"
    }
  },
  {
    "name": "getGroup",
    "description": "Get group by ID. Retrieves detailed information about a specific group.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        }
      },
      "required": ["id"]
    },
    "metadata": {
      "method": "GET",
      "path": "/groups/{id}",
      "requiredPermission": "groups:read"
    }
  },
  {
    "name": "updateGroup",
    "description": "Update group. Updates a group's name and/or description.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "name": {
          "type": "string",
          "description": "Group name"
        },
        "description": {
          "type": "string",
          "description": "Group description"
        }
      },
      "required": ["id"]
    },
    "metadata": {
      "method": "PUT",
      "path": "/groups/{id}",
      "requiredPermission": "groups:write"
    }
  },
  {
    "name": "deleteGroup",
    "description": "Delete group. Permanently deletes a group. Cannot delete system groups or the default group. Cannot delete groups that still have users.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        }
      },
      "required": ["id"]
