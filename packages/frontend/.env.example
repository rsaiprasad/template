# Backend API URL — set to your Cloudflare Tunnel domain for production
# In development, the dev server proxies /api/ to localhost:3000 automatically
PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1

# Firebase Client SDK — get from Firebase Console > Project Settings > General > Your apps > Web app
# Not required in development when using the Firebase Auth emulator
PUBLIC_FIREBASE_API_KEY=AIzaSy...
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
PUBLIC_FIREBASE_APP_ID=1:123:web:abc

# AI Service URL (optional — only if running AI service)
# PUBLIC_AI_SERVICE_URL=ws://localhost:3001
