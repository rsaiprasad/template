# Terraform Variables Example
# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to version control

# Required: GCP Project ID (must be globally unique)
project_id = "my-dashboard-project"

# Required: Super admin email address
super_admin_email = "admin@company.com"

# Optional: Project display name
project_name = "Admin Dashboard"

# Optional: GCP region (default: us-central1)
region = "us-central1"

# Optional: Create a new GCP project (default: false = use existing)
# If true, you must also set billing_account
create_project = false

# Optional: Billing account ID (required only if create_project = true)
# billing_account = "XXXXXX-XXXXXX-XXXXXX"

# Optional: Organization ID (for creating projects under an organization)
# org_id = "123456789"

# Google Sign-In Configuration
# To enable Google Sign-In:
# 1. Go to GCP Console > APIs & Services > Credentials
# 2. Create an OAuth 2.0 Client ID (Web application type)
# 3. Add authorized redirect URI: https://YOUR_PROJECT.firebaseapp.com/__/auth/handler
# 4. Copy the Client ID and Secret below
# 5. Set enable_google_signin = true

enable_google_signin = false
# oauth_client_id     = "YOUR_CLIENT_ID.apps.googleusercontent.com"
# oauth_client_secret = "YOUR_CLIENT_SECRET"

# Monitoring Configuration
# Enable/disable monitoring features and customize alert thresholds
monitoring = {
  enabled = true

  # Audit logging configuration
  audit_logs = {
    enabled   = true
    firestore = true    # Enable Firestore data access logging
    auth      = true    # Enable Identity Toolkit (Auth) logging
    log_types = ["ADMIN_READ", "DATA_READ", "DATA_WRITE"]
  }

  # Notification channels
  notifications = {
    # email = "alerts@company.com"  # Override super_admin_email for alerts
    # slack_webhook = "https://hooks.slack.com/services/..."  # Optional Slack
  }

  # Alert configurations
  alerts = {
    # Authentication failure alerts
    auth_failures = {
      enabled   = true
      threshold = 10      # Number of failures to trigger alert
      window    = "300s"  # Time window (5 minutes)
    }

    # Cloud Function error alerts
    function_errors = {
      enabled   = true
      threshold = 5
      window    = "300s"
    }

    # Firestore error alerts
    firestore_errors = {
      enabled   = true
      threshold = 5
      window    = "300s"
    }

    # High latency request alerts
    high_latency = {
      enabled         = true
      threshold_count = 10       # Number of slow requests to trigger
      latency_seconds = 5        # Requests slower than this (seconds)
      window          = "300s"
    }

    # Uptime monitoring (disabled by default)
    uptime = {
      enabled    = false
      # api_domain = "your-project.web.app"  # Required when enabled
      # check_path = "/api/v1/health"
      # period     = "300s"
      # timeout    = "10s"
    }
  }
}

# Minimal monitoring configuration (just enable with defaults):
# monitoring = { enabled = true }

# Disable monitoring entirely:
# monitoring = { enabled = false }
